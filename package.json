{
  "name": "clio_reader",
  "version": "0.1.0",
  "private": true,
  "description": "Biblioteca local multiplataforma para leer EPUB, PDF, CBZ y futuros formatos.",
  "packageManager": "pnpm@12.16.1+sha256.ca362a16f2e1c3cfa81d406f3242446179a0e4aea457ba3e9e6c39e6476aba65",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm build && pnpm --recursive run check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "next-version": "node scripts/next-version.mjs",
    "validate": "pnpm format:check && pnpm check && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.0",
    "eslint": "^10.9.1",
    "prettier": "^3.6.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^2.1.4"
  }
}
