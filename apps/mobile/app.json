{
  "expo": {
    "name": "Clio Reader",
    "slug": "clio-reader",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#f9fafb"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clio-reader.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f9fafb"
      },
      "package": "com.clio_reader.mobile"
    },
    "plugins": ["expo-document-picker"]
  }
}
