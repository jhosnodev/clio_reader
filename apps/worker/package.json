{
  "name": "@clio-reader/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker de recepción de Clio Feedback Core",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@clio-reader/domain": "workspace:*"
  },
  "devDependencies": {
    "wrangler": "^3.99.0"
  }
}
